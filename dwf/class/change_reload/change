class change {

    public function __construct() {
        opcache_reset();
        $files=[];
        foreach (glob("class/*.class.php") as $value) {
            $files[$value]=sha1_file($value);
        }
        header('Content-Type: application/json');
        echo json_encode($files);
    }

}

new change();
